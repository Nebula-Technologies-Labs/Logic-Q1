meta {
  name: Change Password
  type: http
  seq: 3
  tags: [
    Forgot_Password
  ]
}

post {
  url: {{baseUrl}}/forgotPassword/changePassword/:email
  body: json
  auth: inherit
}

params:path {
  email: john.doe@example.com
}

body:json {
  {
    "password": "newPassword123",
    "repeatPassword": "newPassword123"
  }
}
