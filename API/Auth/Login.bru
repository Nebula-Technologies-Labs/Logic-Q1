meta {
  name: Login
  type: http
  seq: 2
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "john.doe@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
      bru.setVar("token", res.body.token);
  }
}
