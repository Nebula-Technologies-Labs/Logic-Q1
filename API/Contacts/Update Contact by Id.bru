meta {
  name: Update Contact by Id
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/contact/:id
  body: json
  auth: inherit
}

params:path {
  id: {{contactId}}
}

body:json {
  {
    "name": "Johnny Doe",
    //"email": "john@gmail.com",
    "phoneNumber": "9999999999",
    "city": "Chennai",
    "country": "India"
  }
}

vars:pre-request {
  contactId: c8dc2468-8f89-4477-8e31-d164f1a37437
}

settings {
  encodeUrl: true
  timeout: 0
}
