meta {
  name: Update Contact by Id
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/contact/:id
  body: json
  auth: inherit
}

params:path {
  id: {{contactId}}
}

body:json {
  {
    "name": "Johnny Doe",
    "email": "john@gmail.com",
    "phoneNumber": "9999999999",
    "city": "Chennai",
    "country": "India"
  }
}

vars:pre-request {
  contactId: 37fa6b28-677e-40be-a2cd-0e97ce4407fa
}

settings {
  encodeUrl: true
  timeout: 0
}
