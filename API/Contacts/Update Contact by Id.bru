meta {
  name: Update Contact by Id
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/contact/:id
  body: json
  auth: inherit
}

params:path {
  id: {{contactId}}
}

body:json {
  {
    "name": "Johnny Doe",
    "email": "john@gmail.com",
    "phoneNumber": "9999999999",
    "city": "Chennai",
    "country": "India"
  }
}

vars:pre-request {
  contactId: fcb3e44f-0b13-4d32-bb1c-dc00d7ab04b5
}

settings {
  encodeUrl: true
  timeout: 0
}
