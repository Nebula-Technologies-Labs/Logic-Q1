meta {
  name: Update Contact by Id
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/contact/:id
  body: json
  auth: inherit
}

params:path {
  id: {{contactId}}
}

body:json {
  {
    "name": "Johnny Doe",
    //"email": "john@gmail.com",
    "phoneNumber": "9999999999",
    "city": "Chennai",
    "country": "India"
  }
}

vars:pre-request {
  contactId: 158df7b7-0086-436d-9cd9-27c069e78586
}

settings {
  encodeUrl: true
  timeout: 0
}
