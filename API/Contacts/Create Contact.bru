meta {
  name: Create Contact
  type: http
  seq: 1
  tags: [
    Contacts
  ]
}

post {
  url: {{baseUrl}}/contact/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "contact@examplee.com",
    "name": "Alice Smith",
    "phoneNumber": "+1234567890",
    "secondaryEmail": "alice.alt@example.com",
    "description": "Key client",
    "note": "Met at conference",
    "title": "CEO",
    "department": "Executive",
    "contactSource": "Website",
    "country": "US",
    "city": "New York",
    "state": "NY"
  }
}
