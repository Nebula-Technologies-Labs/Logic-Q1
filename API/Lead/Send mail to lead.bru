meta {
  name: Send mail to lead
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/leads/send-mail
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "to": "john.doe@example.com",
    "subject": "Welcome to LogicQ1 CRM",
    "text": "Hello John,\n\nThank you for registering with LogicQ1 CRM.\n\nRegards,\nLogicQ1 Team"
  }
}
